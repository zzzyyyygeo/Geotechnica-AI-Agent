# ============================================================
#  把这个文件另存为 .env（去掉 .example），然后填入真实 Key
#  .env 已被 .gitignore 忽略，不会传到 GitHub
# ============================================================

# 你的 DeepSeek API Key（去 https://platform.deepseek.com/api_keys 创建）
# 注意：不要带引号，不要留空格
DEEPSEEK_API_KEY=sk-替换成你的真实key

# 下面两项一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
